<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="ConnectionName"  value="Debug" />
    <add key ="logFile" value =".\log.txt"/>
    <add key ="DefaultUnitId" value ="1"/>
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
  <connectionStrings>
    <add name="Release" connectionString="Server=(localdb)\MSSQLLocalDB;Integrated Security=true;AttachDbFileName=|DataDirectory|\DB\ProStoreAndSalesDB.mdf"  providerName="SqlClient" />
    <add name ="Debug" connectionString ="Server=(localdb)\MSSQLLocalDB;Integrated Security=true;Initial Catalog=StoreAndSalesDB;"/>
    
  </connectionStrings>
</configuration>