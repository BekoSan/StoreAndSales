<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
  </configSections>
  <appSettings>
    <add key="ConnectionName"  value="Debug22" />
    <add key="logFile"  value=".\log.txt" />
    <add key="DefaultUnitId"  value="1" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
  <connectionStrings>
    <add name="Release" connectionString="Server=(localdb)\MSSQLLocalDB;Integrated Security=true;AttachDbFileName=|DataDirectory|\DB\ProStoreAndSalesDB.mdf"
      providerName="SqlClient" />
    <add name="Debug" connectionString="Server=(localdb)\MSSQLLocalDB;Integrated Security=true;Initial Catalog=StoreAndSalesDB;" />
    <add name="Debug22" connectionString="Server=(localdb)\LocalDB2022;Initial Catalog=ProStoreAndSalesDB;Integrated Security=True" />
    <add name="StoreAndSalesUI.Properties.Settings.ProStoreAndSalesDBConnectionString"
      connectionString="Data Source=(localdb)\LocalDB2022;Initial Catalog=ProStoreAndSalesDB;Integrated Security=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>